# ==========================================
# Application
# ==========================================

PORT=5000
NODE_ENV=development

# Frontend URL allowed by CORS
FRONTEND_URL=http://localhost:5173


# ==========================================
# PostgreSQL Database
# ==========================================

DATABASE_URL=postgresql://username:password@localhost:5432/unwind


# ==========================================
# JWT Authentication
# ==========================================

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

REFRESH_TOKEN_DAYS=30


# ==========================================
# Email — Brevo SMTP
# ==========================================

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_username
SMTP_PASS=your_brevo_smtp_password

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=UNWIND
BREVO_SENDER_EMAIL=no-reply@example.com


# ==========================================
# Cloudinary
# ==========================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ==========================================
# Voice Transcription
# ==========================================

VOICE_TRANSCRIPTION_PROVIDER=groq
VOICE_TRANSCRIPTION_MODEL=whisper-large-v3

# Number of hours before journal unlock expires
JOURNAL_UNLOCK_TOKEN_EXPIRES_HOURS=1


# ==========================================
# AI Provider Credentials
# ==========================================

GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_API_KEY=your_groq_chat_api_key
GROQ_FALLBACK_API_KEY=your_groq_fallback_api_key

GEMINI_API_KEY=your_gemini_api_key

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token


# ==========================================
# AI Chatbot Configuration
# ==========================================

AI_PROVIDER=groq
ENABLE_AI_FALLBACK=true

GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.6-flash
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

CHAT_TEMPERATURE=0.7
MAX_RESPONSE_TOKENS=2048
MAX_CHAT_HISTORY=10
CHAT_TIMEOUT_MS=30000

ENABLE_CHAT_SAFETY=true
ENABLE_CHAT_LOGGING=true

MAX_CHAT_REQUESTS_PER_MINUTE=20
MAX_CHAT_REQUESTS_PER_DAY=200

AI_FALLBACK_ORDER=groq,groq_fast,gemini,cloudflare

ENABLE_PREDEFINED_RESPONSES=true
ENABLE_AI_RESPONSES=true


# ==========================================
# Google OAuth
# ==========================================

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# ==========================================
# Admin Access
# ==========================================

# Store a bcrypt hash, never the actual admin password
ADMIN_ACCESS_PASSWORD_HASH=$2b$12$replace_with_generated_bcrypt_hash


# ==========================================
# PostHog Server Analytics
# ==========================================

POSTHOG_PROJECT_ID=your_posthog_project_id
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key